# 🔒 Simple shared-secret gate for team deployments.
# Localhost only by default. Remote requests require x-harness-key.
HARNESS_KEY=

# ---------------------------------------------------------------------------
# Direct ad-platform integrations (config/ads.yaml mode: direct / dry-run)
# These are SENSITIVE. Never commit real values. Provide them in your shell / CI.
# New department tools use config/ads-module.yaml; config/ads.yaml is legacy skills only.
# ---------------------------------------------------------------------------

# --- Google Ads API (self-hosted) ---
# Developer token (required; obtain from your Google Ads API project).
ADS_DIRECT_GOOGLE_DEVELOPER_TOKEN=
# OAuth access token with scopes for Google Ads (scope:
#   https://www.googleapis.com/auth/adwords)
ADS_DIRECT_GOOGLE_ACCESS_TOKEN=
# Optional: login (MCC parent) customer id if the access token is an MCC.
ADS_DIRECT_GOOGLE_LOGIN_CUSTOMER=

# --- Meta (Facebook/Instagram) Marketing API ---
# Long-lived user or system-user access token with ads_management, ads_read,
# read_insights (and optionally business_management).
ADS_DIRECT_META_ACCESS_TOKEN=

# --- Google Analytics 4 Data API ---
# OAuth access token (scope: https://www.googleapis.com/auth/analytics.readonly)
ADS_DIRECT_GA4_ACCESS_TOKEN=
# Default GA4 property id (e.g. 123456789)
ADS_DIRECT_GA4_PROPERTY_ID=

# Model for report wording, competitor angles and the built-in runner. Optional: without one, reports use
# fixed templates and findings/actions still run (they never use a model). Set both providers for fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# Provider order for chat(), e.g. deepseek,openrouter. Monthly LLM spend cap in USD (alerts at 80%, stops non-essential calls at 100%).
LLM_ORDER=
LLM_MONTHLY_BUDGET_USD=

# --- Competitor research (Meta Ad Library via Apify) ---
# Apify API token; without it competitor research reports an error instead of sample data.
COMPETITOR_API_KEY=
# Apify actor id (default apify~facebook-ads-scraper).
COMPETITOR_APIFY_ACTOR=

# --- Client report branding (white-label) ---
# Name, https logo URL and accent colour on the client report page; name defaults to APP_NAME.
REPORT_BRAND_NAME=
REPORT_LOGO_URL=
REPORT_ACCENT=
# Google OAuth refresh credentials (alternative to short-lived access tokens).
# Get GOOGLE_REFRESH_TOKEN once with: node bin/cli.js google-auth --client <downloaded client JSON> [--ads]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One token for GA4 + Search Console (+ Google Ads); the ADS_DIRECT_*_REFRESH_TOKEN values below override it per product.
GOOGLE_REFRESH_TOKEN=
# Search Console property exactly as listed by google-auth: sc-domain:example.com or https://www.example.com/
GSC_SITE_URL=
ADS_DIRECT_GOOGLE_REFRESH_TOKEN=
ADS_DIRECT_GA4_REFRESH_TOKEN=
# Explicit version overrides, update after provider contract testing.
META_API_VERSION=v26.0
GOOGLE_ADS_API_VERSION=v25
# Optional absolute policy path when launched from another working directory.
ADS_POLICY_FILE=
# Additional bearer gate for remote /api/departments endpoints.
MARKETING_API_TOKEN=

# --- Ad creative generation (src/modules/creative) — all generation via OpenRouter ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Text model for copy/concept briefs; must support structured_outputs on OpenRouter.
OPENROUTER_TEXT_MODEL=
# Image model for backgrounds (the module overlays all text itself).
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Pre-flight cost estimate per image (USD); real cost is read from usage.cost.
CREATIVE_IMAGE_EST_USD=0.04

# Meta Ads MCP proxy (meta_mcp_* tools; same ADS_DIRECT_META_ACCESS_TOKEN, needs extra scopes, see todos-11-10-2026/META-ADS-PARITY-PLAN.md)
ADS_META_MCP=off
ADS_META_MCP_URL=https://mcp.facebook.com/ads

# --- Deployment (one client per deployment; see deploy/README.md) ---
# Storage root for all sqlite/json state (Docker image sets /app/.marketing-data).
DATA_DIR=
# Dashboard branding; defaults to business.name from config/business.yaml.
APP_NAME=
BRAND_INITIAL=
BRAND_WORDMARK=
# Client timezone for scheduled jobs (doctor 06:00, backup 02:30, reports...), e.g. Asia/Kolkata.
TZ=
# Built-in scheduler runs inside the dashboard process; set off to disable.
SCHEDULER=on
# Operator alerts (job dead, doctor red, token expiring, LLM down, ads UNCERTAIN, weekly digest) go to Telegram.
# 1) Message @BotFather -> /newbot -> copy the token. 2) Send your bot any message (or add it to a group).
# 3) Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...} (groups are negative numbers).
# One bot can serve every client; the client name is in each message.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# LLM fallback order among configured providers (deepseek, openrouter). Default: deepseek first.
LLM_ORDER=
# Logs: json in production by default; set text to force human-readable.
LOG_FORMAT=
